#!/usr/bin/env bash
set -euo pipefail
umask 077
PRIVATE_REPO="skj04327/the-twilight-of-korea"
QUEUE_BRANCH="orchestrator/task-queue"

usage() {
  printf 'Usage: ai [--stable] [--controller claude|codex|gemini] [--reference HTTPS_URL] [--image PNG_OR_JPEG] "task" | ai status | ai logs | ai report TASK_ID\n' >&2
  exit 2
}
command -v gh >/dev/null || { echo "GitHub CLI (gh) is required" >&2; exit 1; }
[ "${GITHUB_ACTIONS:-}" != "true" ] || { echo "Private intake requires a local trusted client" >&2; exit 1; }
require_private_queue() {
  local account private
  account="$(gh api --hostname github.com user --jq '.login' 2>/dev/null)" || { echo "GitHub authentication unavailable" >&2; exit 1; }
  [ "$account" = "skj04327" ] || { echo "Sign in to GitHub as skj04327 first" >&2; exit 1; }
  private="$(gh api --hostname github.com "repos/$PRIVATE_REPO" --jq '.private' 2>/dev/null)" || { echo "Cannot verify private queue repository" >&2; exit 1; }
  [ "$private" = "true" ] || { echo "Queue repository must be private" >&2; exit 1; }
}
case "${1:-}" in
  status)
    [ "$#" -eq 1 ] || usage
    require_private_queue
    printf 'Private ready requests (not execution status):\n'
    gh api --hostname github.com "repos/$PRIVATE_REPO/contents/docs/orchestrator/requests?ref=$QUEUE_BRANCH" \
      --jq '.[:20][] | select(.name | test("^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9]+\\.json$")) | .name | sub("\\.json$"; "")' 2>/dev/null || { echo "Cannot read private ready queue; it may not exist yet" >&2; exit 1; }
    exit
    ;;
  report)
    [ "$#" -eq 2 ] || usage
    [[ "$2" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9]+$ ]] || { echo "Invalid task ID" >&2; exit 2; }
    require_private_queue
    gh api --hostname github.com "repos/$PRIVATE_REPO/contents/docs/orchestrator/reports/$2.json?ref=$QUEUE_BRANCH" --jq '.content' | base64 -d
    printf '\n'
    exit
    ;;
  logs)
    printf 'Raw task logs remain private. Use ai report TASK_ID. Local diagnostics are not yet implemented.\n' >&2
    exit 2
    ;;
esac
mode="auto"
controller="auto"
reference_url=""
image_file=""
while [ "$#" -gt 1 ]; do
  case "${1:-}" in
    --stable)
      [ "$mode" = "auto" ] || usage
      mode="stable"
      shift
      ;;
    --controller)
      [ "$mode" = "auto" ] && [ "$#" -ge 3 ] || usage
      case "$2" in
        claude|codex|gemini) controller="$2";;
        *) usage;;
      esac
      mode="manual"
      shift 2
      ;;
    --reference)
      [ -z "$reference_url" ] && [ "$#" -ge 3 ] || usage
      reference_url="$2"
      [ "${#reference_url}" -le 500 ] || { echo "Reference URL is too long" >&2; exit 2; }
      [[ "$reference_url" == https://* ]] || { echo "Reference must use HTTPS" >&2; exit 2; }
      case "$reference_url" in
        *\"*|*\\*|*$'\n'*|*$'\r'*|*$'\t'*) echo "Invalid reference URL" >&2; exit 2;;
      esac
      shift 2
      ;;
    --image)
      [ -z "$image_file" ] && [ "$#" -ge 3 ] || usage
      image_file="$2"
      [ -f "$image_file" ] && [ ! -L "$image_file" ] || { echo "Image must be a regular file" >&2; exit 2; }
      case "${image_file##*.}" in
        png|jpg|jpeg) ;;
        *) echo "Only .png .jpg .jpeg accepted" >&2; exit 2;;
      esac
      bytes="$(wc -c < "$image_file" | tr -d '[:space:]')"
      [ "$bytes" -ge 24 ] && [ "$bytes" -le 700000 ] || { echo "Image must be 24-700000 bytes" >&2; exit 2; }
      shift 2
      ;;
    *) usage;;
  esac
done
[ "$#" -eq 1 ] || usage
task="$1"
[ -n "${task//[[:space:]]/}" ] || usage
[ "${#task}" -le 2500 ] || { echo "Task too long (max 2500 characters)" >&2; exit 2; }
command -v sha256sum >/dev/null || { echo "sha256sum is required" >&2; exit 1; }
require_private_queue
id="$(date -u +%Y%m%dT%H%M%SZ)-$RANDOM-$RANDOM"
work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT
printf '%s' "$task" > "$work/task.txt"
files=("$work/task.txt")
paths=("docs/orchestrator/tasks/$id.txt")
kinds=(task)
if [ -n "$reference_url" ]; then
  printf '{"version":1,"urls":["%s"]}' "$reference_url" > "$work/references.json"
  files+=("$work/references.json")
  paths+=("docs/orchestrator/references/$id.json")
  kinds+=(references)
fi
if [ -n "$image_file" ]; then
  extension="${image_file##*.}"
  # Capture once, with a read bound. Upload and hash precisely this snapshot.
  head -c 700001 -- "$image_file" > "$work/image.$extension"
  bytes="$(wc -c < "$work/image.$extension" | tr -d '[:space:]')"
  [ "$bytes" -ge 24 ] && [ "$bytes" -le 700000 ] || { echo "Captured image size is invalid" >&2; exit 2; }
  files+=("$work/image.$extension")
  paths+=("docs/orchestrator/media/$id.$extension")
  kinds+=(image)
fi
# A final readiness proof binds the exact uploaded bytes and preserves routing.
{
  printf '{"schemaVersion":1,"taskId":"%s","routing":{"mode":"%s","controller":"%s"},"inputs":[' "$id" "$mode" "$controller"
  separator=""
  for i in "${!files[@]}"; do
    digest="$(sha256sum -- "${files[$i]}")"
    digest="${digest%% *}"
    bytes="$(wc -c < "${files[$i]}" | tr -d '[:space:]')"
    printf '%s{"kind":"%s","path":"%s","size":%s,"sha256":"%s"}' "$separator" "${kinds[$i]}" "${paths[$i]}" "$bytes" "$digest"
    separator=","
  done
  printf ']}'
} > "$work/ready.json"
upload_private() {
  local path="$1" file="$2"
  {
    printf '{"message":"queue input %s","branch":"%s","content":"' "$id" "$QUEUE_BRANCH"
    base64 < "$file" | tr -d '\r\n'
    printf '"}'
  } > "$work/request.json"
  if ! gh api --hostname github.com -X PUT "repos/$PRIVATE_REPO/contents/$path" --input "$work/request.json" --silent 2>"$work/gh-error"; then
    printf 'Private queue upload failed before readiness completed. Task ID: %s\n' "$id" >&2
    return 1
  fi
}
for i in "${!files[@]}"; do upload_private "${paths[$i]}" "${files[$i]}"; done
# Never publish readiness for a partial upload. No public Actions dispatch.
upload_private "docs/orchestrator/requests/$id.json" "$work/ready.json"
printf 'Queued privately. Task ID: %s\n' "$id"
printf 'Execution: not started; no private worker is configured yet.\n'
printf 'Status: ai status\n'
