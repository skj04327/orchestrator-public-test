#!/usr/bin/env bash
set -euo pipefail
PUBLIC_REPO="skj04327/orchestrator-public-test"
PRIVATE_REPO="skj04327/the-twilight-of-korea"
QUEUE_BRANCH="orchestrator/task-queue"
WORKFLOW="task-intake.yml"

usage() {
  printf 'Usage: ai [--stable] [--controller claude|codex|gemini] [--reference HTTPS_URL] [--image PNG_OR_JPEG] "task" | ai status | ai logs | ai report TASK_ID\n' >&2
  exit 2
}
command -v gh >/dev/null || { echo "GitHub CLI (gh) is required" >&2; exit 1; }
case "${1:-}" in
  status)
    gh run list -R "$PUBLIC_REPO" --workflow "$WORKFLOW" --limit 8
    exit
    ;;
  report)
    [ "$#" -eq 2 ] || usage
    [[ "$2" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9]+$ ]] || { echo "Invalid task ID" >&2; exit 2; }
    gh api "repos/$PRIVATE_REPO/contents/docs/orchestrator/reports/$2.json?ref=$QUEUE_BRANCH" --jq '.content' | base64 -d
    printf '\n'
    exit
    ;;
  logs)
    id="$(gh run list -R "$PUBLIC_REPO" --workflow "$WORKFLOW" --limit 1 --json databaseId --jq '.[0].databaseId')"
    [ -n "$id" ] && [ "$id" != "null" ] || { echo "No workflow runs"; exit 1; }
    gh run view "$id" -R "$PUBLIC_REPO" --log
    exit
    ;;
esac
mode="auto"
controller="auto"
reference_url=""
image_file=""
while [ "$#" -gt 1 ]; do
  case "${1:-}" in
    --stable)
      [ "$mode" = "auto" ] || usage
      mode="stable"
      shift
      ;;
    --controller)
      [ "$mode" = "auto" ] && [ "$#" -ge 3 ] || usage
      case "$2" in
        claude|codex|gemini) controller="$2";;
        *) usage;;
      esac
      mode="manual"
      shift 2
      ;;
    --reference)
      [ -z "$reference_url" ] && [ "$#" -ge 3 ] || usage
      reference_url="$2"
      [ "${#reference_url}" -le 500 ] || { echo "Reference URL is too long" >&2; exit 2; }
      [[ "$reference_url" == https://* ]] || { echo "Reference must use HTTPS" >&2; exit 2; }
      case "$reference_url" in
        *\"*|*\\*|*$'\n'*|*$'\r'*|*$'\t'*) echo "Invalid reference URL" >&2; exit 2;;
      esac
      shift 2
      ;;
    --image)
      [ -z "$image_file" ] && [ "$#" -ge 3 ] || usage
      image_file="$2"
      [ -f "$image_file" ] && [ ! -L "$image_file" ] || { echo "Image must be a regular file" >&2; exit 2; }
      case "${image_file##*.}" in
        png|jpg|jpeg) ;;
        *) echo "Only .png .jpg .jpeg accepted" >&2; exit 2;;
      esac
      bytes="$(wc -c < "$image_file" | tr -d '[:space:]')"
      [ "$bytes" -ge 24 ] && [ "$bytes" -le 700000 ] || { echo "Image must be 24-700000 bytes" >&2; exit 2; }
      shift 2
      ;;
    *) usage;;
  esac
done
[ "$#" -eq 1 ] || usage
task="$1"
[ -n "${task//[[:space:]]/}" ] || usage
[ "${#task}" -le 2500 ] || { echo "Task too long (max 2500 characters)" >&2; exit 2; }
account="$(gh api user --jq '.login')"
[ "$account" = "skj04327" ] || { echo "Sign in to GitHub as skj04327 first" >&2; exit 1; }
id="$(date -u +%Y%m%dT%H%M%SZ)-$RANDOM-$RANDOM"
path="docs/orchestrator/tasks/$id.txt"
content="$(printf '%s' "$task" | base64 | tr -d '\r\n')"
gh api -X PUT "repos/$PRIVATE_REPO/contents/$path" \
  -f message="queue: add private orchestration request $id" \
  -f branch="$QUEUE_BRANCH" -f content="$content" --silent
# Optional reference material stays in the PRIVATE task-queue branch.
# Use temporary JSON request bodies rather than passing large image bytes as CLI arguments.
if [ -n "$reference_url" ]; then
  tmp="$(mktemp)"
  trap 'rm -f "${tmp:-}"' EXIT
  {
    printf '{"message":"refs %s","branch":"%s","content":"' "$id" "$QUEUE_BRANCH"
    printf '{"version":1,"urls":["%s"]}' "$reference_url" | base64 | tr -d '\r\n'
    printf '"}'
  } > "$tmp"
  gh api -X PUT "repos/$PRIVATE_REPO/contents/docs/orchestrator/references/$id.json" \
    --input "$tmp" --silent
  rm -f "$tmp"
  trap - EXIT
fi
if [ -n "$image_file" ]; then
  tmp="$(mktemp)"
  trap 'rm -f "${tmp:-}"' EXIT
  {
    printf '{"message":"image %s","branch":"%s","content":"' "$id" "$QUEUE_BRANCH"
    base64 < "$image_file" | tr -d '\r\n'
    printf '"}'
  } > "$tmp"
  gh api -X PUT "repos/$PRIVATE_REPO/contents/docs/orchestrator/media/$id.${image_file##*.}" \
    --input "$tmp" --silent
  rm -f "$tmp"
  trap - EXIT
fi
if gh workflow run "$WORKFLOW" -R "$PUBLIC_REPO" -f task_id="$id" -f routing_mode="$mode" -f controller="$controller"; then
  printf 'Queued privately. Task ID: %s\n' "$id"
  printf 'Status: ai status\n'
else
  printf 'The task was saved privately but could not dispatch Actions. Task ID: %s\n' "$id" >&2
  exit 1
fi
